#!/usr/bin/env bash

set -e

shopt -s nullglob

CONFIG_DIR="$HOME/.config/mkproj"
TEMPLATES_DIR="$CONFIG_DIR/templates"
BIN_DIR="$HOME/.local/bin"
mkdir -p "$CONFIG_DIR/templates" "$BIN_DIR"
script_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
DEFAULT_REPO="https://github.com/SadDevastator/mkproj.git"

RED="\033[31m"
GREEN="\033[32m"
YELLOW="\033[33m"
BLUE="\033[34m"
BOLD="\033[1m"
RESET="\033[0m"

info() { printf "%b\n" "${BLUE}${1}${RESET}"; }
success() { printf "%b\n" "${GREEN}${1}${RESET}"; }
warn() { printf "%b\n" "${YELLOW}${1}${RESET}"; }
err() { printf "%b\n" "${RED}${1}${RESET}"; }

# Name fragment used for DEPS_<KEY> arrays and mkproj_create_<key> hooks:
# template name with anything that isn't a valid identifier char mapped to "_".
tmpl_key() {
    local key="${1//[^A-Za-z0-9_]/_}"
    printf "%s" "$key"
}

deps_var() {
    local key
    key="$(tmpl_key "$1")"
    printf "DEPS_%s" "${key^^}"
}

# Populate DEPS_<TEMPLATE> from the template's .sh module and/or legacy .conf file.
load_deps() {
    local tmpl="$1" var
    var="$(deps_var "$tmpl")"
    declare -g -A "$var"
    source_config_module "$tmpl" || true

    local variant conf line
    for variant in "${tmpl^^}" "${tmpl^}" "${tmpl,,}"; do
        conf="$CONFIG_DIR/config/${variant}.conf"
        [[ -f "$conf" ]] || continue
        local -n _deps="$var"
        while IFS= read -r line; do
            [[ -z "$line" || "$line" == \#* || "$line" != *=* ]] && continue
            _deps["${line%%=*}"]="${line#*=}"
        done < "$conf"
        break
    done
}

# Ensure a command exists. If an installer command is given, offer to run it and
# prepend the optional bin dir to PATH afterwards. Used by config module hooks.
require_cmd() {
    local cmd="$1" installer="$2" bin_dir="$3" ans
    command -v "$cmd" &>/dev/null && return 0
    [[ -n "$bin_dir" && -x "$bin_dir/$cmd" ]] && { export PATH="$bin_dir:$PATH"; return 0; }

    if [[ -z "$installer" ]]; then
        err "$cmd is required but was not found. Install it (or re-run with --auto-install) and try again."
        return 1
    fi

    warn "$cmd not found."
    read -r -p "Install it now? (This will run: $installer) [Y/n]: " ans
    if [[ ! "${ans:-Y}" =~ ^[Yy] ]]; then
        err "$cmd is required. Aborting."
        return 1
    fi
    sh -c "$installer" || { err "$cmd install failed"; return 1; }

    [[ -n "$bin_dir" ]] && export PATH="$bin_dir:$PATH"
    hash -r
    if ! command -v "$cmd" &>/dev/null; then
        err "$cmd still not found after installation. Restart your shell or add it to PATH and try again."
        return 1
    fi
}

update_templates() {
    info "Updating templates..."
    mkdir -p "$TEMPLATES_DIR"

    # If the templates dir is a git repo, try to pull first
    if [[ -d "$TEMPLATES_DIR/.git" ]]; then
        git -C "$TEMPLATES_DIR" pull -q || warn "git pull in templates repo failed"
        success "Templates updated from git"
    fi

    # Determine which repo to use for templates: env override or default repo
    repo_to_clone="${MKPROJ_TEMPLATES_REPO:-$DEFAULT_REPO}"
    if [[ -n "$repo_to_clone" ]]; then
        if command -v git &>/dev/null; then
            tmpdir=$(mktemp -d)
            if git clone --depth 1 "$repo_to_clone" "$tmpdir"; then
                # If the cloned repo contains a templates/ folder, install those
                if [[ -d "$tmpdir/templates" ]]; then
                    for d in "$tmpdir/templates"/*; do
                        [[ -d "$d" ]] || continue
                        base="$(basename "$d")"
                        rm -rf "$TEMPLATES_DIR/$base"
                        cp -a "$d" "$TEMPLATES_DIR/" 2>/dev/null || cp -r "$d" "$TEMPLATES_DIR/" 2>/dev/null || true
                        success "Reinstalled template from repo: $base"
                    done
                    success "Templates cloned and reinstalled from $repo_to_clone"
                else
                    warn "Cloned repo $repo_to_clone but no templates/ directory found inside it"
                fi
                rm -rf "$tmpdir"
            else
                warn "Failed to clone $repo_to_clone"
                rm -rf "$tmpdir"
            fi
        else
            warn "git not available; cannot clone templates from $repo_to_clone"
        fi
    fi

    # Reinstall bundled templates by overwriting existing user templates
    if [[ -d "$script_dir/templates" ]]; then
        for d in "$script_dir/templates"/*; do
            [[ -d "$d" ]] || continue
            base="$(basename "$d")"
            rm -rf "$TEMPLATES_DIR/$base"
            cp -a "$d" "$TEMPLATES_DIR/" 2>/dev/null || cp -r "$d" "$TEMPLATES_DIR/" 2>/dev/null || true
            success "Reinstalled bundled template: $base"
        done
        success "Bundled templates reinstalled into $TEMPLATES_DIR"
        return 0
    fi

    warn "No bundled templates found and no MKPROJ_TEMPLATES_REPO set. Nothing to reinstall."
}

find_config_sh() {
    local tmpl="$1"
    local confdir="$CONFIG_DIR/config"
    local variant
    for variant in "${tmpl^^}" "${tmpl^}" "${tmpl,,}"; do
        if [[ -f "$confdir/${variant}.sh" ]]; then
            printf "%s" "$confdir/${variant}.sh"
            return 0
        fi
    done
    for variant in "${tmpl^^}" "${tmpl^}" "${tmpl,,}"; do
        if [[ -f "$script_dir/config/${variant}.sh" ]]; then
            printf "%s" "$script_dir/config/${variant}.sh"
            return 0
        fi
    done
    # Case-insensitive basename match (e.g. "typescript" -> TypeScript.sh)
    local f
    for f in "$confdir"/*.sh "$script_dir/config"/*.sh; do
        if [[ "${tmpl,,}" == "$(basename "$f" .sh | tr '[:upper:]' '[:lower:]')" ]]; then
            printf "%s" "$f"
            return 0
        fi
    done
    return 1
}

source_config_module() {
    local tmpl="$1"
    local cfg
    if cfg="$(find_config_sh "$tmpl")"; then
        . "$cfg"
        return 0
    fi
    return 1
}

find_template() {
    local tmpl="$1"
    local candidate

    # Exact match in user templates
    if [[ -d "$TEMPLATES_DIR/$tmpl" ]]; then
        printf "%s" "$TEMPLATES_DIR/$tmpl"
        return 0
    fi

    # Try common case variants in user templates
    for candidate in "${tmpl^^}" "${tmpl^}" "${tmpl,,}"; do
        if [[ -d "$TEMPLATES_DIR/$candidate" ]]; then
            printf "%s" "$TEMPLATES_DIR/$candidate"
            return 0
        fi
    done

    # Case-insensitive search by basename in user templates
    if [[ -d "$TEMPLATES_DIR" ]]; then
        for d in "$TEMPLATES_DIR"/*; do
            [[ -d "$d" ]] || continue
            if [[ "${tmpl,,}" == "$(basename "$d" | tr '[:upper:]' '[:lower:]')" ]]; then
                printf "%s" "$d"
                return 0
            fi
        done
    fi

    # Fallback to bundled templates shipped with the script
    if [[ -d "$script_dir/templates" ]]; then
        if [[ -d "$script_dir/templates/$tmpl" ]]; then
            printf "%s" "$script_dir/templates/$tmpl"
            return 0
        fi
        for candidate in "${tmpl^^}" "${tmpl^}" "${tmpl,,}"; do
            if [[ -d "$script_dir/templates/$candidate" ]]; then
                printf "%s" "$script_dir/templates/$candidate"
                return 0
            fi
        done
        for d in "$script_dir/templates"/*; do
            [[ -d "$d" ]] || continue
            if [[ "${tmpl,,}" == "$(basename "$d" | tr '[:upper:]' '[:lower:]')" ]]; then
                printf "%s" "$d"
                return 0
            fi
        done
    fi

    return 1
}

usage() {
    echo "Usage:"
    echo "  mkproj create <project-name> <template>[:<variant>] [--auto-install] [--git] [--code|-C] [--dir <path>] [--update] [-- <args>...]"
    echo "  mkproj add-template <source-folder|-> <template-name> [--script <script-path>] [--dependencies \"k=v[,k2=v2...]\"] [--force]"
    echo "  mkproj remove-template <template-name> [--force]"
    echo "  mkproj update-dependancies <template-name> \"k=v[,k2=v2...]\""
    echo "  mkproj update-templates"
    echo "  mkproj update"
    echo "  mkproj uninstall [--yes]"
    echo "  mkproj list-templates"
    echo "  mkproj completions <zsh|fish>"
    exit 1
}

list_templates() {
    echo "Available templates in $CONFIG_DIR:"
    declare -A _seen_templates=()
    local found=0

    # List user templates
    if [[ -d "$TEMPLATES_DIR" ]]; then
        for d in "$TEMPLATES_DIR"/*; do
            [[ -d "$d" ]] || continue
            name="$(basename "$d")"
            printf "  - %s\n" "$name"
            _seen_templates["$name"]=1
            found=1
        done
    fi

    # Include bundled templates (if any) but avoid duplicates
    if [[ -d "$script_dir/templates" ]]; then
        for d in "$script_dir/templates"/*; do
            [[ -d "$d" ]] || continue
            name="$(basename "$d")"
            if [[ -z "${_seen_templates[$name]}" ]]; then
                printf "  - %s (bundled)\n" "$name"
                _seen_templates["$name"]=1
                found=1
            fi
        done
    fi

    # Also include templates referenced by config modules (.sh)
    if [[ -d "$CONFIG_DIR/config" ]]; then
        for f in "$CONFIG_DIR/config"/*.sh; do
            [[ -f "$f" ]] || continue
            name="$(basename "$f" .sh)"
            if [[ -z "${_seen_templates[$name]}" ]]; then
                printf "  - %s (config)\n" "$name"
                _seen_templates["$name"]=1
                found=1
            fi
        done
    fi

    # Bundled config modules
    if [[ -d "$script_dir/config" ]]; then
        for f in "$script_dir/config"/*.sh; do
            [[ -f "$f" ]] || continue
            name="$(basename "$f" .sh)"
            if [[ -z "${_seen_templates[$name]}" ]]; then
                printf "  - %s (bundled-config)\n" "$name"
                _seen_templates["$name"]=1
                found=1
            fi
        done
    fi

    if [[ $found -eq 0 ]]; then
        echo "  (no templates found)"
    fi
}

# Unique template names, one per line (used by shell completions).
template_names() {
    local d f
    {
        for d in "$TEMPLATES_DIR"/* "$script_dir/templates"/*; do
            [[ -d "$d" ]] && basename "$d"
        done
        for f in "$CONFIG_DIR/config"/*.sh "$script_dir/config"/*.sh; do
            [[ -f "$f" ]] && basename "$f" .sh
        done
    } | sort -fu
}

completions() {
    case "$1" in
        zsh) completions_zsh ;;
        fish) completions_fish ;;
        *) echo "Usage: mkproj completions <zsh|fish>" >&2; exit 1 ;;
    esac
}

completions_zsh() {
    cat <<'ZSH'
#compdef mkproj mkproject
# zsh completion for mkproj. Works from $fpath or when sourced after compinit.

_mkproj_templates() {
    local -a tmpls
    tmpls=(${(f)"$(mkproj template-names 2>/dev/null)"})
    compadd -S '' -q -a tmpls
}

_mkproj() {
    local -a cmds
    cmds=(
        'create:scaffold a project from a template'
        'add-template:add a template folder or script'
        'remove-template:remove a user template'
        'update-dependancies:write legacy dependency mappings'
        'list-templates:list available templates'
        'update-templates:reinstall templates from the repo'
        'update:update mkproj itself'
        'uninstall:remove mkproj'
        'completions:print a shell completion script'
    )

    if (( CURRENT == 2 )); then
        _describe -t commands 'mkproj command' cmds
        return
    fi

    # Everything after `--` belongs to the template's tool
    (( ${words[(I)--]} && ${words[(I)--]} < CURRENT )) && return

    case $words[2] in
        create)
            case $words[CURRENT-1] in
                --dir) _directories; return ;;
            esac
            if (( CURRENT == 3 )); then
                _message 'project name'
            elif (( CURRENT == 4 )); then
                _mkproj_templates
            else
                compadd -- --auto-install --git --code -C --dir --update --
            fi
            ;;
        add-template)
            case $words[CURRENT-1] in
                --script) _files; return ;;
                --dependencies) _message 'k=v[,k2=v2...]'; return ;;
            esac
            if (( CURRENT == 3 )); then
                compadd -- -; _directories
            elif (( CURRENT == 4 )); then
                _message 'template name'
            else
                compadd -- --script --dependencies --force
            fi
            ;;
        remove-template)
            if (( CURRENT == 3 )); then _mkproj_templates; else compadd -- --force; fi
            ;;
        update-dependancies)
            if (( CURRENT == 3 )); then _mkproj_templates; else _message 'k=v[,k2=v2...]'; fi
            ;;
        uninstall)
            compadd -- --yes
            ;;
        completions)
            (( CURRENT == 3 )) && compadd -- zsh fish
            ;;
    esac
}

if [[ "${funcstack[1]}" == "_mkproj" ]]; then
    _mkproj "$@"
else
    (( $+functions[compdef] )) || { autoload -Uz compinit && compinit; }
    compdef _mkproj mkproj mkproject
fi
ZSH
}

completions_fish() {
    cat <<'FISH'
# fish completion for mkproj

function __mkproj_no_dashdash
    not contains -- -- (commandline -opc)
end

set -l cmds create add-template remove-template update-dependancies list-templates update-templates update uninstall completions

for c in mkproj mkproject
    complete -c $c -f
    complete -c $c -n "not __fish_seen_subcommand_from $cmds" -a create -d 'Scaffold a project from a template'
    complete -c $c -n "not __fish_seen_subcommand_from $cmds" -a add-template -d 'Add a template folder or script'
    complete -c $c -n "not __fish_seen_subcommand_from $cmds" -a remove-template -d 'Remove a user template'
    complete -c $c -n "not __fish_seen_subcommand_from $cmds" -a update-dependancies -d 'Write legacy dependency mappings'
    complete -c $c -n "not __fish_seen_subcommand_from $cmds" -a list-templates -d 'List available templates'
    complete -c $c -n "not __fish_seen_subcommand_from $cmds" -a update-templates -d 'Reinstall templates from the repo'
    complete -c $c -n "not __fish_seen_subcommand_from $cmds" -a update -d 'Update mkproj itself'
    complete -c $c -n "not __fish_seen_subcommand_from $cmds" -a uninstall -d 'Remove mkproj'
    complete -c $c -n "not __fish_seen_subcommand_from $cmds" -a completions -d 'Print a shell completion script'

    # create <name> <template> [options]
    complete -c $c -n "__fish_seen_subcommand_from create; and test (count (commandline -opc)) -eq 3" -a "(mkproj template-names 2>/dev/null)" -d template
    complete -c $c -n "__fish_seen_subcommand_from create; and __mkproj_no_dashdash" -l auto-install -d 'Install missing dependencies'
    complete -c $c -n "__fish_seen_subcommand_from create; and __mkproj_no_dashdash" -l git -d 'Initialize a git repo'
    complete -c $c -n "__fish_seen_subcommand_from create; and __mkproj_no_dashdash" -l code -s C -d 'Open in VS Code'
    complete -c $c -n "__fish_seen_subcommand_from create; and __mkproj_no_dashdash" -l update -d 'Update an existing project'
    complete -c $c -n "__fish_seen_subcommand_from create; and __mkproj_no_dashdash" -l dir -r -a "(__fish_complete_directories)" -d 'Parent directory'

    # add-template <src|-> <name> [options]
    complete -c $c -n "__fish_seen_subcommand_from add-template; and test (count (commandline -opc)) -eq 2" -a "- (__fish_complete_directories)"
    complete -c $c -n "__fish_seen_subcommand_from add-template" -l script -r -F -d 'Create hook script'
    complete -c $c -n "__fish_seen_subcommand_from add-template" -l dependencies -r -d 'k=v[,k2=v2...]'
    complete -c $c -n "__fish_seen_subcommand_from add-template" -l force -s f -d 'Overwrite without prompting'

    complete -c $c -n "__fish_seen_subcommand_from remove-template update-dependancies; and test (count (commandline -opc)) -eq 2" -a "(mkproj template-names 2>/dev/null)" -d template
    complete -c $c -n "__fish_seen_subcommand_from remove-template" -l force -s f -d 'Skip confirmation'
    complete -c $c -n "__fish_seen_subcommand_from uninstall" -l yes -s y -d 'Do not prompt'
    complete -c $c -n "__fish_seen_subcommand_from completions" -a "zsh fish"
end
FISH
}

update_self() {
    info "Running remote installer to update mkproj and reinstall default templates..."
    if command -v curl >/dev/null 2>&1; then
        bash -c "$(curl -fsSL https://raw.githubusercontent.com/SadDevastator/mkproj/master/install.sh)"
    else
        err "curl is required to run remote installer. Please install curl and re-run 'mkproj update', or run the installer manually."
        return 1
    fi
}

detect_pkgmgr() {
    local pkgmanagers=("apt" "dnf" "pacman" "zypper" "apk" "xbps-install")
    for mgr in "${pkgmanagers[@]}"; do
        if command -v "$mgr" &>/dev/null; then
            echo "$mgr"
            return
        fi
    done
    echo "unknown"
}

install_missing() {
    local tmpl="$1"
    load_deps "$tmpl"

    local -n depmap="$(deps_var "$tmpl")"
    local missing=()
    for dep in "${!depmap[@]}"; do
        command -v "$dep" &>/dev/null || missing+=("${depmap[$dep]}")
    done

    if [[ ${#missing[@]} -eq 0 ]]; then
        echo "All dependencies installed."
        return
    fi

    warn "Missing dependencies: ${missing[*]}"

    declare -a pkgmgrs=()
    for candidate in apt dnf pacman zypper apk xbps-install; do
        command -v "$candidate" &>/dev/null && pkgmgrs+=("$candidate")
    done

    primary=$(detect_pkgmgr)

    echo
    info "Available package managers:"
    idx=1
    for mgr in "${pkgmgrs[@]}"; do
        if [[ "$mgr" == "$primary" ]]; then
            echo "  $idx) $mgr (primary)"
        else
            echo "  $idx) $mgr"
        fi
        ((idx++))
    done
    echo "  $idx) none (skip installation)"
    read -p "Choose package manager [$idx]: " choice
    choice=${choice:-$idx}

    if [[ "$choice" -lt "$idx" ]]; then
        selected="${pkgmgrs[$((choice-1))]}"
        info "Installing using $selected..."
        case "$selected" in
            apt)
                sudo apt install -y "${missing[@]}" ;;
            dnf)
                sudo dnf install -y "${missing[@]}" ;;
            pacman)
                sudo pacman -S --noconfirm "${missing[@]}" ;;
            zypper)
                sudo zypper install -y "${missing[@]}" ;;
            apk)
                sudo apk add "${missing[@]}" ;;
            xbps-install)
                sudo xbps-install -y "${missing[@]}" ;;
        esac
    else
        warn "Skipping installation. You may install dependencies manually later."
    fi
}

# Run a template hook function, or fall back to a <script> inside the project.
# Hooks run from the parent dir and get: <name> <project-dir> <variant> [extra args...]
run_hook() {
    local fn="$1" script="$2" name="$3" dest="$4" parent="$5" variant="$6"
    shift 6
    if declare -F "$fn" >/dev/null 2>&1; then
        info "Running template hook: $fn"
        (cd "$parent" && PROJECT_NAME="$name" PROJECT_DIR="$dest" "$fn" "$name" "$dest" "$variant" "$@")
    elif [[ -f "$dest/$script" ]]; then
        info "Running template hook: $dest/$script"
        (cd "$dest" && PROJECT_NAME="$name" PROJECT_DIR="$dest" "$SHELL" "./$script" "$@")
    fi
}

create_project() {
    local name="$1" spec="$2"
    shift 2 || true
    local auto_install=0 git_init=0 open_code=0 update_only=0
    local -a extra_args=()

    local target_dir
    target_dir="$(pwd)"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --auto-install)
                auto_install=1
                shift
                ;;
            --update)
                update_only=1
                shift
                ;;
            --git)
                git_init=1
                shift
                ;;
            --code|-C)
                open_code=1
                shift
                ;;
            --dir)
                target_dir="$2"
                shift 2
                ;;
            --dir=*)
                target_dir="${1#*=}"
                shift
                ;;
            --)
                shift
                extra_args=("$@")
                break
                ;;
            --*)
                echo "Unknown option: $1"
                shift
                ;;
            *)
                shift
                ;;
        esac
    done

    [[ -z "$name" || -z "$spec" ]] && usage

    # "<template>:<variant>" passes <variant> to the template's hooks (e.g. bun:astro).
    local tmpl="${spec%%:*}" variant=""
    [[ "$spec" == *:* ]] && variant="${spec#*:}"

    mkdir -p "$target_dir"
    target_dir="$(cd "$target_dir" && pwd)"
    local dest="$target_dir/$name"
    local existed=0
    [[ -e "$dest" ]] && existed=1
    if ((existed)) && [[ $update_only -ne 1 ]]; then
        err "Destination '$dest' already exists. Use --update to update an existing project."
        exit 1
    fi

    local tmpl_dir=""
    tmpl_dir="$(find_template "$tmpl")" || tmpl_dir=""
    source_config_module "$tmpl" || true

    local key
    key="$(tmpl_key "$tmpl")"
    local create_fn="mkproj_create_${key,,}" update_fn="mkproj_update_${key,,}"
    if [[ -z "$tmpl_dir" ]] && ! declare -F "$create_fn" >/dev/null 2>&1; then
        err "Unsupported template: $tmpl"
        list_templates
        exit 1
    fi

    ((auto_install)) && install_missing "$tmpl"

    if [[ -n "$tmpl_dir" ]]; then
        info "Using template: $tmpl_dir"
        mkdir -p "$dest"
        cp -r "$tmpl_dir/." "$dest/"
        # Escape \ & / so any name is a literal replacement; only text files that use the placeholder.
        local repl="${name//\\/\\\\}"
        repl="${repl//&/\\&}"
        repl="${repl//\//\\/}"
        grep -rlIZ '{{PROJECT_NAME}}' "$dest" | xargs -0 -r sed -i "s/{{PROJECT_NAME}}/$repl/g"
    fi

    if ((existed)); then
        run_hook "$update_fn" update.sh "$name" "$dest" "$target_dir" "$variant" "${extra_args[@]}" \
            || { err "Update hook for '$tmpl' failed."; exit 1; }
        success "Project '$name' ($spec) updated."
    else
        run_hook "$create_fn" create.sh "$name" "$dest" "$target_dir" "$variant" "${extra_args[@]}" \
            || { err "Create hook for '$tmpl' failed."; exit 1; }
        if [[ ! -d "$dest" ]]; then
            err "Template '$tmpl' did not create $dest."
            exit 1
        fi
        success "Project '$name' ($spec) created at $dest"
    fi

    if ((git_init)); then
        git -C "$dest" init -q && info "Git initialized"
    fi
    if ((open_code)) && command -v code &>/dev/null; then
        code "$dest"
    fi
    return 0
}

add_template() {
    local src="$1" tmpl="$2"
    shift 2 || true
    local deps_arg="" script_arg=""
    local force=0

    [[ -z "$tmpl" ]] && { echo "Usage: mkproj add-template <source-folder|-> <template-name> [--script <script-path>] [--dependencies \"k=v[,k2=v2...]\"]"; exit 1; }

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dependencies|--dependancies)
                deps_arg="$2"
                shift 2
                ;;
            --dependencies=*)
                deps_arg="${1#*=}"
                shift
                ;;
            --dependancies=*)
                deps_arg="${1#*=}"
                shift
                ;;
            --script)
                script_arg="$2"
                shift 2
                ;;
            --script=*)
                script_arg="${1#*=}"
                shift
                ;;
            --force|-f)
                force=1
                shift
                ;;
            *)
                echo "Unknown option: $1"
                shift
                ;;
        esac
    done

    if [[ "$src" != "-" && ! -d "$src" ]]; then
        echo "Source folder '$src' does not exist or is not a directory." >&2
        exit 1
    fi

    mkdir -p "$TEMPLATES_DIR"
    local dest="$TEMPLATES_DIR/$tmpl"

    if [[ -e "$dest" ]]; then
        if [[ $force -ne 1 ]]; then
            read -r -p "Template destination '$dest' exists. Overwrite? [y/N]: " ans
            case "$ans" in
                [Yy]*) rm -rf "$dest" ;;
                *) echo "Aborted."; return 1 ;;
            esac
        else
            rm -rf "$dest"
        fi
    fi

    if [[ "$src" != "-" ]]; then
        mkdir -p "$dest"
        cp -a "$src/." "$dest/" 2>/dev/null || cp -r "$src/." "$dest/" 2>/dev/null || cp -r "$src" "$dest" 2>/dev/null
        echo "Template copied to: $dest"
    else
        mkdir -p "$dest"
        echo "Created template folder: $dest (no files, script-only)"
    fi

    if [[ -n "$deps_arg" ]]; then
        mkdir -p "$CONFIG_DIR/config"
        local conf_sh="$CONFIG_DIR/config/${tmpl^^}.sh" var
        var="$(deps_var "$tmpl")"
        printf "declare -g -A %s\n" "$var" > "$conf_sh"
        local normalized
        normalized="$(echo "$deps_arg" | tr ',' '\n')"
        while IFS= read -r pair; do
            [[ -z "$pair" ]] && continue
            pair="$(echo "$pair" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
            if [[ "$pair" != *=* ]]; then
                echo "Skipping invalid dependency entry: $pair" >&2
                continue
            fi
            key="${pair%%=*}"
            val="${pair#*=}"
            printf "%s[\"%s\"]=\"%s\"\n" "$var" "$key" "$val" >> "$conf_sh"
        done <<< "$normalized"
        success "Wrote dependencies to $conf_sh"
    fi

    if [[ -n "$script_arg" ]]; then
        if [[ ! -f "$script_arg" ]]; then
            echo "Script '$script_arg' not found." >&2
            return 1
        fi
        mkdir -p "$dest"
        cp -f "$script_arg" "$dest/create.sh"
        chmod +x "$dest/create.sh"
        success "Installed template script to $dest/create.sh"
    fi

    success "add-template complete. Run 'mkproj list-templates' to verify templates."
}

remove_template() {
    local name="$1"
    [[ -z "$name" ]] && { echo "Usage: mkproj remove-template <template-name>"; exit 1; }

    local force=0

    if [[ "$2" == "--force" || "$2" == "-f" ]]; then
        force=1
    fi

    local target=""
    if [[ -d "$TEMPLATES_DIR/$name" ]]; then
        target="$TEMPLATES_DIR/$name"
    else
        for d in "$TEMPLATES_DIR"/*; do
            [[ -d "$d" ]] || continue
            if [[ "${name,,}" == "$(basename "$d" | tr '[:upper:]' '[:lower:]')" ]]; then
                target="$d"
                break
            fi
        done
    fi

    if [[ -z "$target" ]]; then
        echo "Template '$name' not found in $TEMPLATES_DIR" >&2
        exit 1
    fi

    if [[ $force -ne 1 ]]; then
        read -p "Permanently remove template '$target' and its dependency file? [y/N]: " ans
        case "$ans" in
            [Yy]*) ;;
            *) echo "Aborted."; return 1 ;;
        esac
    fi

    rm -rf "$target"
    echo "Removed template directory: $target"

    local base="$(basename "$target")"
    local conf_sh="$CONFIG_DIR/config/${base^^}.sh"
    local conf_file="$CONFIG_DIR/config/${base^^}.conf"
    if [[ -f "$conf_sh" ]]; then
        rm -f "$conf_sh"
        echo "Removed dependency config: $conf_sh"
    fi
    if [[ -f "$conf_file" ]]; then
        rm -f "$conf_file"
        echo "Removed legacy dependency config: $conf_file"
    fi
}


uninstall() {
    local assume_yes=0
    if [[ "$1" == "--yes" || "$1" == "-y" ]]; then
        assume_yes=1
    fi

    echo "This will remove the installed mkproj binary and optional user config/templates." 
    if [[ $assume_yes -ne 1 ]]; then
        read -p "Proceed with uninstall? [y/N]: " ans
        case "$ans" in
            [Yy]*) ;;
            *) echo "Aborted."; return 1 ;;
        esac
    fi

    # Remove binaries
    if [[ -f "$BIN_DIR/mkproj" ]]; then
        rm -f "$BIN_DIR/mkproj" && echo "Removed $BIN_DIR/mkproj"
    else
        echo "No $BIN_DIR/mkproj found"
    fi
    if [[ -L "$BIN_DIR/mkproject" || -f "$BIN_DIR/mkproject" ]]; then
        # only remove if it points to the installed path or exists
        rm -f "$BIN_DIR/mkproject" && echo "Removed $BIN_DIR/mkproject"
    fi

    # Remove PATH snippet and completion line from shells (only files that contain them)
    local zshrc="${ZDOTDIR:-$HOME}/.zshrc"
    for rc in "$HOME/.profile" "$HOME/.bashrc" "$zshrc"; do
        [[ -f "$rc" ]] || continue
        if grep -qxF 'export PATH="$HOME/.local/bin:$PATH"' "$rc" || grep -qF '# mkproj completions' "$rc"; then
            sed -i.bak -e '/^export PATH="\$HOME\/\.local\/bin:\$PATH"$/d' -e '/# mkproj completions$/d' "$rc" 2>/dev/null || true
            echo "Cleaned mkproj lines from $rc (backup: ${rc}.bak)"
        fi
    done
    local data_home="${XDG_DATA_HOME:-$HOME/.local/share}" f
    for f in "$data_home/man/man1/mkproj.1" "$data_home/tealdeer/pages/mkproj.page.md"; do
        [[ -f "$f" ]] && rm -f "$f" && echo "Removed $f"
    done
    if [[ -f "$HOME/.config/fish/completions/mkproj.fish" ]]; then
        rm -f "$HOME/.config/fish/completions/mkproj.fish" && echo "Removed fish completions"
    fi
    if command -v fish >/dev/null 2>&1; then
        fish_conf="$HOME/.config/fish/config.fish"
        if [[ -f "$fish_conf" ]]; then
            sed -i.bak '/set -gx PATH \$HOME\/\.local\/bin \$PATH/d' "$fish_conf" 2>/dev/null || true
            echo "Cleaned fish config (backup: ${fish_conf}.bak)"
        fi
    fi

    # Optionally remove user config
    if [[ -d "$CONFIG_DIR" ]]; then
        if [[ $assume_yes -ne 1 ]]; then
            read -p "Remove user config at $CONFIG_DIR (templates, config)? [y/N]: " ans2
            case "$ans2" in
                [Yy]*) rm -rf "$CONFIG_DIR" && echo "Removed $CONFIG_DIR" ;;
                *) echo "Left $CONFIG_DIR in place" ;;
            esac
        else
            rm -rf "$CONFIG_DIR" && echo "Removed $CONFIG_DIR"
        fi
    else
        echo "No user config directory at $CONFIG_DIR"
    fi

    echo "Uninstall complete. You may want to restart your shell to refresh PATH." 
}

update_dependancies() {
    local name="$1" deps_arg="$2"
    [[ -z "$name" || -z "$deps_arg" ]] && { echo "Usage: mkproj update-dependancies <template-name> \"k=v[,k2=v2...]\""; exit 1; }

    local tmpl=""
    if [[ -d "$TEMPLATES_DIR/$name" ]]; then
        tmpl="$TEMPLATES_DIR/$name"
    else
        for d in "$TEMPLATES_DIR"/*; do
            [[ -d "$d" ]] || continue
            if [[ "${name,,}" == "$(basename "$d" | tr '[:upper:]' '[:lower:]')" ]]; then
                tmpl="$d"
                break
            fi
        done
    fi

    if [[ -z "$tmpl" ]]; then
        echo "Template '$name' not found in $TEMPLATES_DIR" >&2
        exit 1
    fi

    mkdir -p "$CONFIG_DIR/config"
    local base="$(basename "$tmpl")"
    local conf_file="$CONFIG_DIR/config/${base^^}.conf"
    echo "# Updated by mkproj on $(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$conf_file"
    local normalized
    normalized="$(echo "$deps_arg" | tr ',' '\n')"
    while IFS= read -r pair; do
        [[ -z "$pair" ]] && continue
        pair="$(echo "$pair" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
        if [[ "$pair" != *=* ]]; then
            echo "Skipping invalid dependency entry: $pair" >&2
            continue
        fi
        echo "$pair" >> "$conf_file"
    done <<< "$normalized"
    echo "Wrote dependencies to $conf_file"
}

[[ $# -lt 1 ]] && usage
cmd="$1"; shift

case "$cmd" in
    create)
        create_project "$@"
        ;;
    update)
        update_self "$@"
        ;;
    uninstall)
        uninstall "$@"
        ;;
    add-template)
        add_template "$@"
        ;;
    remove-template)
        remove_template "$@"
        ;;
    update-dependancies)
        update_dependancies "$@"
        ;;
    list-templates)
        list_templates
        ;;
    update-templates)
        update_templates
        ;;
    template-names)
        template_names
        ;;
    completions)
        completions "$@"
        ;;
    *)
        usage
        ;;
esac
